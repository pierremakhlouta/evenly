# Copy to .env.local and fill in. Never commit real values.
# Only the project URL and the publishable (anon) key belong here.
# The secret / service_role key is never used by this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Web Push public key (public by design); the private key lives only in Supabase secrets.
VITE_VAPID_PUBLIC_KEY=
